(text "ESP-PSRAM64H: 8 MB ring buffer for the encrypted recording stream" (exclude_from_sim no) (at 13.97 13.208 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "06ab7519-8501-5da2-8104-8c03225b0a6a"))
(text "Own QSPI bus, separate from the flash. Ciphertext only.\nCE pull-up keeps the part deselected during configuration." (exclude_from_sim no) (at 78.74 78.74 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bd916f4b-a495-5653-9033-e81e9ced186d"))
(text "MicroSD: encrypted recordings, user data, event log, offline update packages" (exclude_from_sim no) (at 13.97 97.028 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "488d4484-cbeb-587f-b603-886ac8eeebde"))
(text "SPI mode first, 4-bit SD if the\nrecording rate needs it.\nSD_CD_N low = card present." (exclude_from_sim no) (at 127 142.24 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c6776c2e-a732-5589-a6a7-bf21f7164c61"))
(text "Notes\n1. Both parts are outside the trust boundary: they only ever hold ciphertext.\n2. TF-01A needs a footprint from its data sheet (or the EasyEDA model for C91145)." (exclude_from_sim no) (at 154.94 17.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a42d906c-315c-568b-8e61-af2a2b3d923a"))
