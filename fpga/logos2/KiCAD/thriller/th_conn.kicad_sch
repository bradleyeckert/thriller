(text "J2: audio (plaintext I2S), display, speaker, carrier clocks, GPIO0..31." (exclude_from_sim no) (at 220 80 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "0c46b689-7bb1-45dc-864e-c5610f2ca995"))

(text "Pinout per hw/module.md (H11): nothing but signals leaves the module; +5V_IN on 1-3 and 41-43; a ground next to every signal group; JTAG on J1 is unrouted on production carriers; contacts marked no-connect are reserved. VBAT_CELL: RTC backup from the carrier cells. ETH_LED1/2 are the PHY LED outputs for the carrier jack." (exclude_from_sim no) (at 20 20 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "60d664b1-4f16-4d74-adac-3c6baaa42043")))
